# Data (downloaded from Zenodo at run time, so not baked into the image).
# data/ is where the pipeline downloads the Zenodo deposit
# (_targets.R: output_dir = "data/01_data_replication").
data/

# Pipeline store and outputs (regenerated inside the container)
_targets/
outputs/

# Local R package library and renv caches
renv/library/
renv/staging/
renv/cache/

# Local R session history and IDE settings
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Version control
.git/
.gitignore

# Operating system files
.DS_Store
Thumbs.db
